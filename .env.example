# Copy to .env when running via docker compose interpolation, or export in the shell.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/future_message
DB_USERNAME=future
DB_PASSWORD=future

# JWT — production must set a unique secret of at least 32 characters
JWT_SECRET=local-dev-only-change-me-32bytes-min-key!

# Admin bootstrap — creates ADMIN if this email is not registered yet.
# Local defaults match application.yml. Production must set unique values; leave empty to skip.
ADMIN_EMAIL=admin@futuremessage.local
ADMIN_PASSWORD=adminpass1
ADMIN_DISPLAY_NAME=Admin

# Local demo users + LOCKED / FAILED messages for the admin UI. Disable in production.
# APP_DEV_SEED_ENABLED=true

# CORS (comma-separated origins or Spring origin patterns)
CORS_ALLOWED_ORIGINS=http://localhost:[*],http://127.0.0.1:[*]

# Mail (Mailpit in docker-compose: SMTP 1025, UI http://localhost:8025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@futuremessage.local
MAIL_INBOX_URL=http://localhost:5173/inbox

# Unlock scheduler (Spring relaxed binding → app.scheduler.unlock.*)
# APP_SCHEDULER_UNLOCK_ENABLED=true
# APP_SCHEDULER_UNLOCK_INTERVAL=30s
# APP_SCHEDULER_UNLOCK_BATCH_SIZE=50

# Notification (email) scheduler
# APP_SCHEDULER_NOTIFICATION_ENABLED=true
# APP_SCHEDULER_NOTIFICATION_INTERVAL=30s
# APP_SCHEDULER_NOTIFICATION_BATCH_SIZE=50

# Used by docker-compose postgres service
POSTGRES_DB=future_message
POSTGRES_USER=future
POSTGRES_PASSWORD=future
POSTGRES_PORT=5432
