# Copy to .env when running via docker compose interpolation, or export in the shell.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/future_message
DB_USERNAME=future
DB_PASSWORD=future

# Mail (Mailpit in docker-compose: SMTP 1025, UI http://localhost:8025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@futuremessage.local

# Used by docker-compose postgres service
POSTGRES_DB=future_message
POSTGRES_USER=future
POSTGRES_PASSWORD=future
POSTGRES_PORT=5432
